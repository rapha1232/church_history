<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wbg_n" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_mark" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/wic_mark_n" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="CHURCH HISTORY" android:textColor="@color/wn_acc" android:textSize="10sp" android:letterSpacing="0.16" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="" android:textSize="11sp" android:maxLines="1" android:textColor="@color/wn_sub"/>
        </LinearLayout>
        <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Tap to open." android:textSize="14sp" android:maxLines="3" android:textColor="@color/wn_text" android:fontFamily="serif" android:lineSpacingMultiplier="1.15" android:ellipsize="end"/>
    </LinearLayout>
</FrameLayout>
