<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wbg_n" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_mark" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/wic_mark_n" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="CONTINUE READING" android:textColor="@color/wn_acc" android:textSize="10sp" android:letterSpacing="0.16" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="" android:textSize="11sp" android:maxLines="1" android:textColor="@color/wn_sub"/>
        </LinearLayout>
        <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="10dp" android:text="The Council of Nicaea" android:textSize="16sp" android:maxLines="3" android:textColor="@color/wn_text" android:fontFamily="serif" android:lineSpacingMultiplier="1.15" android:ellipsize="end"/>
        <TextView android:id="@+id/w_orig" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="" android:textColor="@color/wn_acc2" android:textSize="15sp" android:fontFamily="serif" android:lineSpacingMultiplier="1.2"
            android:maxLines="3" android:ellipsize="end" android:textDirection="anyRtl" android:visibility="gone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_by" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Episode 4 · Season 2" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/wn_sub"/>
            <ImageView android:id="@+id/w_share" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:padding="8dp"
                android:background="@drawable/wbtn_n" android:src="@drawable/wic_share_n" android:contentDescription="Share" android:visibility="gone"/>
            <ImageView android:id="@+id/w_next" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:padding="8dp"
                android:background="@drawable/wbtn_n" android:src="@drawable/wic_next_n" android:contentDescription="Next" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
