<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same for cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup.json"/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup.json"/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
