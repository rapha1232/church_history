 "terms": {
  "theos": [
   "Θεός · Deus",
   "God. The creed opens by confessing one God, the Father, against both pagan polytheism and Gnostic ideas of a lesser creator."
  ],
  "pantokrator": [
   "παντοκράτωρ · omnipotens",
   "“Ruler of all”, “almighty”. In Greek the stress is on God’s rule over all things; Latin omnipotens stresses power to do all things. Also the name of the classic icon of Christ."
  ],
  "monogenes": [
   "μονογενής · unigenitus",
   "“Only-begotten” or “unique”: the Son’s relation to the Father is unlike any creature’s. From John 1:14, 18 and 3:16."
  ],
  "deumdedeo": [
   "Deum de Deo",
   "“God from God”: present in the creed of 325 and in the Latin form, but not in the Greek text of 381."
  ],
  "ekousias": [
   "ἐκ τῆς οὐσίας τοῦ Πατρός",
   "“From the substance of the Father”: Nicaea’s phrase excluding the idea that the Son was made from nothing. Dropped in 381 as redundant beside homoousios."
  ],
  "homoousios": [
   "ὁμοούσιος · consubstantialis",
   "“Of one substance (essence)” with the Father. The key word of Nicaea: the Son is fully God, not a superior creature. Long contested because it is not in Scripture."
  ],
  "sarkothenta": [
   "σαρκωθέντα · incarnatus est",
   "“Made flesh” (John 1:14): the eternal Son took a real human body."
  ],
  "enanthropesanta": [
   "ἐνανθρωπήσαντα · homo factus est",
   "“Became human”: stronger than “took flesh”, it affirms a complete humanity, soul and mind included, against later views like Apollinarius’."
  ],
  "zoopoion": [
   "ζωοποιόν · vivificantem",
   "“Life-giving”: the Spirit does what only God does, a deliberate claim to his divinity added in 381."
  ],
  "ekporeuomenon": [
   "ἐκπορευόμενον · procedit",
   "“Proceeds” (John 15:26). The Greek verb means to issue from a source, and the Father is the one source. Latin procedere is broader, which is part of the Filioque debate."
  ],
  "filioque": [
   "Filioque",
   "“And the Son”: added in the Latin West (Toledo, 589; used at Rome from 1014). The East objects both to the doctrine as usually understood and to changing an ecumenical creed unilaterally."
  ],
  "katholike": [
   "καθολική · catholica",
   "“Universal, according to the whole”: first used of the Church by Ignatius of Antioch (c. 110). Not a denominational label in the creed."
  ],
  "inferos": [
   "descendit ad inferos",
   "“He descended to the dead” (literally “to those below”). Added in the fourth century in some creeds; it affirms that Christ truly died and went to the realm of the dead, traditionally to free the righteous (1 Peter 3:19)."
  ],
  "communio": [
   "sanctorum communionem",
   "Either “the communion of saints” (the fellowship of all believers, living and dead) or “communion in holy things” (the sacraments). A late (5th-century) addition in Gaul."
  ],
  "carnis": [
   "carnis resurrectionem",
   "Literally “the resurrection of the flesh”: an emphatic rejection of views that only the soul is saved."
  ]
