  {"s": "Acts and the letters", "items": [
    {"t": "The Lord’s Supper", "c": [["MAT", "26:26-29"], ["MAR", "14:22-25"], ["LUK", "22:14-20"], ["1CO", "11:23-26"]], "n": "Paul’s account is probably the oldest written."},
    {"t": "Paul’s conversion, told three times", "c": [["ACT", "9:1-19"], ["ACT", "22:3-16"], ["ACT", "26:9-18"]]},
    {"t": "Peter and Cornelius, and Peter’s report", "c": [["ACT", "10:9-48"], ["ACT", "11:1-18"]]},
