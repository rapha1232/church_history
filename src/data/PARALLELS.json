    {"t": "Cyrus lets the exiles return", "c": [["2CH", "36:22-23"], ["EZR", "1:1-4"]], "n": "The last words of Chronicles, the last book of the Hebrew Bible, are the first words of Ezra."},
    {"t": "The list of those who returned", "c": [["EZR", "2:1-70"], ["NEH", "7:6-73"]]}
  ]},
  {"s": "Psalms and prophets", "items": [
    {"t": "“The fool says in his heart”", "c": [["PSA", "14:1-7"], ["PSA", "53:1-6"]], "n": "The same psalm twice: Psalm 14 uses the name LORD, Psalm 53 says God."},
    {"t": "“Make haste to help me”", "c": [["PSA", "40:13-17"], ["PSA", "70:1-5"]]},
    {"t": "A psalm built from two others", "c": [["PSA", "108:1-13"], ["PSA", "57:7-11, 60:5-12"]]},
