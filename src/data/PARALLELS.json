[
  {"s": "The Law", "items": [
    {"t": "Two accounts of creation", "c": [["GEN", "1:1-2:3"], ["GEN", "2:4-25"]], "n": "The six days, then the garden: two tellings placed side by side at the start of the Bible."},
    {"t": "A wife said to be a sister", "c": [["GEN", "12:10-20"], ["GEN", "20:1-18"], ["GEN", "26:1-11"]], "n": "The same story told of Abraham in Egypt, of Abraham at Gerar, and of Isaac at Gerar."},
    {"t": "Hagar in the wilderness", "c": [["GEN", "16:1-16"], ["GEN", "21:8-21"]]},
    {"t": "Manna and quails", "c": [["EXO", "16:1-36"], ["NUM", "11:4-35"]]},
    {"t": "Water from the rock", "c": [["EXO", "17:1-7"], ["NUM", "20:1-13"]]},
    {"t": "The Ten Commandments", "c": [["EXO", "20:1-17"], ["DEU", "5:6-21"]], "n": "Deuteronomy gives a different reason for keeping the sabbath and a different order in the last commandment."},
    {"t": "Freeing Hebrew slaves", "c": [["EXO", "21:1-11"], ["DEU", "15:12-18"]]},
    {"t": "Clean and unclean animals", "c": [["LEV", "11:1-47"], ["DEU", "14:3-21"]]},
    {"t": "The feasts of the year", "c": [["LEV", "23:1-44"], ["DEU", "16:1-17"]]},
    {"t": "The spies sent into Canaan", "c": [["NUM", "13:1-33"], ["DEU", "1:19-46"]], "n": "Numbers tells the story; in Deuteronomy Moses retells it to the next generation."}
  ]},
